# Copy this file to .env.local on each PC, then fill in the values.
# Never commit .env.local or paste token values into chat/logs.

export GITHUB_TOKEN="paste_your_github_token_here"
export GH_TOKEN="$GITHUB_TOKEN"

# Optional but useful for gh CLI automation.
export GITHUB_REPOSITORY_OWNER="your-github-username-or-org"
export GITHUB_REPOSITORY_NAME="your-repo-name"

# Optional commit identity for shared machines.
export GIT_AUTHOR_NAME="Gabriel"
export GIT_AUTHOR_EMAIL="your-email@example.com"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

